# Copy to .env and fill in. .env is gitignored: never commit real values.

# Flask session signing key (required). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# PostgreSQL (POSTGRES_PASSWORD is required)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=ipay
POSTGRES_USER=ipay
POSTGRES_PASSWORD=

# 1 once the application is served over HTTPS
SESSION_COOKIE_SECURE=0

# --- Server only (docker-compose.prod.yml) ---
# Public host name; Caddy gets its HTTPS certificate for it automatically.
IPAY_DOMAIN=
# Contact address for the Let's Encrypt account
ACME_EMAIL=it@ingenious.sg
# Required on a server: first-run setup only opens at /setup?token=<this value>
SETUP_TOKEN=
# 1 shows the "Demo" marker on every page
IPAY_DEMO=1
